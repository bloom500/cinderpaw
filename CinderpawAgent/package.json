{
  "name": "cinderpaw-agent",
  "version": "2026.8.11",
  "description": "Cinderpaw Agent — proactive, portable AI agent with a native security sandbox",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "cinderpaw": "bin/cinderpaw.js",
    "feral": "bin/cinderpaw.js"
  },
  "files": [
    "bin",
    "brain.example.json",
    "README.md"
  ],
  "license": "Apache-2.0",
  "author": "Bloom Media",
  "homepage": "https://github.com/bloom500/cinderpaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloom500/cinderpaw.git",
    "directory": "CinderpawAgent"
  },
  "bugs": {
    "url": "https://github.com/bloom500/cinderpaw/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "local-first",
    "sandbox",
    "cinderpaw",
    "llm"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "brain:bench": "bun run src/brain-substrate/bench/run.ts",
    "build": "bun build src/index.ts --compile --outfile dist/cinderpaw-agent",
    "build:js": "bun build src/index.ts --target=bun --outfile dist/cinderpaw-agent.js",
    "package:win": "node scripts/package-win.mjs"
  },
  "optionalDependencies": {
    "@bloommedia/cinderpaw-agent-win32-x64": "2026.7.19",
    "@bloommedia/cinderpaw-agent-darwin-arm64": "2026.7.19",
    "@bloommedia/cinderpaw-agent-darwin-x64": "2026.7.19",
    "@bloommedia/cinderpaw-agent-linux-x64": "2026.7.19"
  },
  "devDependencies": {
    "@larksuiteoapi/node-sdk": "1.73.3",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.17.0",
    "@types/bun": "latest",
    "@types/qrcode-terminal": "^0.12.2",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "apache-arrow": "21.1.0",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.26.4",
    "gpt-tokenizer": "^3.4.0",
    "nostr-tools": "2.25.2",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^7.0.0",
    "unpdf": "^1.8.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "undici": ">=8.9.0"
  },
  "dependencies": {
    "zca-js": "2.1.2"
  }
}
