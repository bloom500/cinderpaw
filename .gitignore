# Rust / Cargo
target/
# Stray cargo target dir from an alternate `--target-dir` check run.
target-check/

# Machine-specific local GPU dev launcher (hardcoded VS / Vulkan SDK paths).
dev-gpu.bat

# Local one-off diagnostic scripts (machine-specific absolute paths).
CinderpawAgent/tools/

# Tauri
src-tauri/target/
src-tauri/WixTools/

# Frontend build & deps
frontend-react/dist/
frontend-react/target/
node_modules/

# Cinderpaw agent sidecar build output (only .gitkeep is tracked)
CinderpawAgent/dist/
src-tauri/binaries/*.exe
src-tauri/binaries/cinderpaw-agent

# Compiled Bun scripts under scripts/ — sources (.ts/.mjs/.ps1) are
# tracked, the .exe is a build artifact (e.g. scripts/fake-lora-trainer.exe
# from `bun build --compile scripts/fake-lora-trainer.ts`).
scripts/*.exe

# Go TUI binary (go build output)
tui/cinderpaw-tui.exe
tui/cinderpaw-tui
tui/cinderpaw-tui.exe
tui/cinderpaw-tui

# Git worktrees (paseo / git worktree add)
.worktrees/

# Graphify cache / output
graphify-out/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Env / secrets
.env
.env.local

# Tauri signing keys — NEVER commit these
.tauri-key
.tauri-key.pub
*.tauri-key
*.tauri-key.pub

# Tauri dev / Vite dev logs (untracked build output).
# D3 fix: the real filenames are `.tauri-dev.log` / `.tauri-dev.err`;
# the previous entries (`.cinderpaw-tauri.log`, `.cinderpaw-dev.log`) were stale
# and never matched what Tauri actually wrote.
.tauri-dev.log
.tauri-dev.err
.vite-dev.log
.vite-dev.log.err

# Released installers — never commit the bundle artifacts.
# Build with `cargo tauri build`; upload via the GitHub release workflow.
Cinderpaw_*.msi
Cinderpaw_*-setup.exe
Cinderpaw_*.exe

# Internal handoff / diagnostic scripts that have lived at the repo root.
# They are session-scoped and should not be tracked.
HANDOFF.md
fix-retry-*.py
remove-diagnostic.py

# Tauri signing keys
.tauri/

# Local runtime data (agent DB)
data/

# Sidecar binary backups
src-tauri/binaries/*.old*

# vitest on-disk cache (must never be tracked)
node_modules/.vite/

# Dev run / benchmark logs (never tracked)
*.log
*.log.err

# Scratch / draft scratchpad (mascot bases, worktree salvage) — never tracked
.drafts/

# Locally-installed Claude Code plugin skills (.claude/ config IS tracked, these aren't)
.claude/skills/
.aider*

# Internal process artifacts (session briefs, audits, plans, strategy drafts)
# — kept locally, never published. Untracked pre-v1.0 launch.
PLAN.md
.run-tauri-dev.ps1
run-*.bat
docs/agents-memory/
docs/audits/
docs/marketing/
docs/superpowers/
