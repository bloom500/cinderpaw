{
  "name": "feral-agent",
  "version": "0.2.2",
  "description": "Feral Agent — proactive, portable AI agent with a native security sandbox",
  "type": "module",
  "module": "src/index.ts",
  "license": "MIT",
  "author": "Bloom Media",
  "homepage": "https://github.com/bloom500/feral#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloom500/feral.git",
    "directory": "FeralAgent"
  },
  "bugs": {
    "url": "https://github.com/bloom500/feral/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "local-first",
    "sandbox",
    "feral",
    "llm"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build src/index.ts --compile --outfile dist/feral-agent"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.17.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.26.4",
    "gpt-tokenizer": "^3.4.0",
    "qrcode-terminal": "^0.12.0"
  }
}
