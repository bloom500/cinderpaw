{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feral",
  "version": "0.1.5",
  "identifier": "ai.feral.app",
  "build": {
    "frontendDist": "../frontend-react/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix D:/FeralLocalAI/frontend-react run dev",
    "beforeBuildCommand": "cd ../frontend-react && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Feral",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/feral-agent"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMjY0Mzg1MkQ3MkFCNzMKUldSenEzSXRoVU1tTUplWmQ0SHNhMEw2WVd2ZmpHWjRTdTdZMnNXYkIrM0NmSkNRVVZBWmsvaDkK",
      "endpoints": [
        "https://github.com/bloom500/feral/releases/latest/download/latest.json"
      ]
    }
  }
}
