{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feral",
  "version": "0.2.2",
  "identifier": "ai.feral.app",
  "build": {
    "frontendDist": "../frontend-react/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": {
      "script": "node scripts/build-sidecar.mjs && npm --prefix ../frontend-react run dev",
      "cwd": "."
    },
    "beforeBuildCommand": {
      "script": "node scripts/build-sidecar.mjs && cd ../frontend-react && npm run build",
      "cwd": "."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Feral",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "rpm"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/feral-agent"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzRDY0OTcwRTVDNzYwOTgKUldTWVlNZmxjRW5XWXh4dEsxN2cyaUxHRFlUWGhRbkJWUE51WG9qK05mUzcrTWpmQWd2anE4b2QK",
      "endpoints": [
        "https://github.com/bloom500/feral/releases/latest/download/latest.json"
      ]
    }
  }
}
